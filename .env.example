# Porta HTTP
PORT=3000

# Arquivo SQLite (criado automaticamente, com migração para o schema atual)
DB_FILE=data/encurtador.db

# Domínio público usado nos links curtos. Obrigatório em produção atrás de proxy.
PUBLIC_BASE_URL=https://enc.exemplo.com

# Segredo do servidor (HMAC de IPs para rate limit, cookies de desbloqueio).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, o segredo muda a cada boot e os desbloqueios ativos são invalidados.
APP_SECRET=

# E-mail que recebe papel de admin no cadastro (o primeiro cadastro também vira admin).
ADMIN_EMAIL=

# Modo privado: se definido, o cadastro exige este código de convite.
INVITE_CODE=

# 1 = confiar em X-Forwarded-For (use só atrás de proxy que sobrescreve o cabeçalho).
TRUST_PROXY=0

# production ativa cookies Secure.
NODE_ENV=development
